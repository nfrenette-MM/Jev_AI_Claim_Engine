# ==============================================================================
# JEV AI Claim Engine - Environment Configuration Template
# ==============================================================================

# Neon Serverless Postgres (or local SQLite fallback)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-branch-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini / Antigravity LLM
GEMINI_API_KEY=your_gemini_api_key

# TypeSafe Jev AI Decision Engine
TYPESAFE_API_KEY=your_jev_api_key

# Redis (Job Queue & Cache)
REDIS_URL=redis://localhost:6379

# MCP FHIR Server Target (Operative & EHR Charts)
FHIR_SERVER_URL=https://fhir.example-ehr.com/r4
FHIR_TOKEN=your_fhir_bearer_token

# Databricks Lakehouse & Unity Catalog
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_databricks_personal_access_token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=claims_rcm
